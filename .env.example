# Creators AquaHub - Environment Configuration Template
# PRE-LAUNCH POLICY: ₹0 Expenditure. Free tiers only. No paid plans, no secrets in source control.

# Mobile / Public Configuration (Safe public identifiers only)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Cloudinary Public Configuration
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=aquahub_mobile_preset

# Supabase Server-Side Secrets (Deno Edge Functions Only - Never in Mobile Bundle)
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1

# Resend Custom SMTP (Used by Supabase Auth Dashboard)
# SMTP Host: smtp.resend.com, Port: 465, User: resend
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM_ADDRESS=auth@auth.creatorsaquarium.com

# Cloudinary Server Secret (Edge Function Signing Only)
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Inference (Free Quota Only: 10,000 Free Neurons/Day on Cloudflare or Groq Developer Tier)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_AI_API_TOKEN=your_cloudflare_ai_api_token
AI_MOCK_MODE=true
AI_DAILY_USER_LIMIT=15
